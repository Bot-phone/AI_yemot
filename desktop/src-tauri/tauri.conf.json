{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI_yemot",
  "identifier": "com.aiyemot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "AI yemot — עורך קווי ימות המשיח",
        "width": 1050,
        "height": 800,
        "minWidth": 850,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; form-action 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Bot-phone",
    "category": "Productivity",
    "shortDescription": "AI yemot",
    "longDescription": "עורך קווי ימות המשיח מבוסס AI — משימה, שינויים מוצעים, אישור, יומן שינויים",
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENBQTI5RTg2RjI1NDBEQzMKUldURERWVHlocDZpeWc2bnJUSVczdGJpQVFJcUNlUzRvL3BDZW40ZWQ0Qkp3amVhMjgrNk9Yc24K",
      "endpoints": [
        "https://github.com/Bot-phone/AI_yemot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
