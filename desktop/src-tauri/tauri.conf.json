{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI_yemot",
  "version": "1.0.0",
  "identifier": "com.aiyemot.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "AI yemot — עדכון שלוחות חכם",
        "width": 1050,
        "height": 800,
        "minWidth": 850,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
